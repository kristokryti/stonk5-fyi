# No API keys are required for the default data sources (stonkfun.xyz public
# API and Dexscreener's public API are both keyless). These are optional
# overrides / future extension points only.

# Override the stonkfun.xyz API base if it ever changes.
# STONKFUN_API_BASE=https://www.stonkfun.xyz/api/public/v1

# Override the Dexscreener API base if it ever changes.
# DEXSCREENER_API_BASE=https://api.dexscreener.com/latest/dex

# Optional: a dedicated Solana RPC (e.g. Helius) for future on-chain reads
# (holder counts, supply verification) beyond what the two APIs above provide.
# SOLANA_RPC_URL=

# Optional: enables a real 24h buy/sell USD volume split on the "Who's
# buying and selling" card (via Birdeye's trade-data endpoint). Without this,
# that stat falls back to GeckoTerminal's honestly-labeled partial window.
# BIRDEYE_API_KEY=
